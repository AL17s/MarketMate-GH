{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier"] },
        "businessId": { "type": "string" },
        "fcmToken": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "businesses": {
      "title": "Business",
      "description": "SME business profile and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "country": { "type": "string" },
        "location": { "type": "string" },
        "branch": { "type": "string" },
        "ownerId": { "type": "string" },
        "phone": { "type": "string" },
        "tinNumber": { "type": "string" },
        "graVatFlatRateEnabled": { "type": "boolean" },
        "monthlyExpenseCap": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "currency", "ownerId"]
    },
    "products": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "unit": { "type": "string" },
        "supplierId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "lastRestockDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "costPrice", "sellingPrice", "stockQuantity"]
    },
    "sales": {
      "title": "Sale",
      "description": "Point of sale transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "businessId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "costAmount": { "type": "number" },
        "grossProfit": { "type": "number" },
        "taxAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "momo_mtn", "momo_telecel", "momo_at", "credit"] },
        "momoNumber": { "type": "string" },
        "momoReference": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "pending", "voided"] },
        "itemsSummary": { "type": "string" },
        "itemCount": { "type": "number" },
        "cashReceived": { "type": "number" },
        "changeGiven": { "type": "number" },
        "cashierId": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "businessId", "totalAmount", "paymentMethod", "status"]
    },
    "sale_items": {
      "title": "SaleItem",
      "description": "Item lines linked to a sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "saleId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "unitCost": { "type": "number" },
        "unitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "subtotal": { "type": "number" },
        "profit": { "type": "number" }
      },
      "required": ["id", "saleId", "productId", "unitPrice", "quantity", "subtotal"]
    },
    "expenses": {
      "title": "Expense",
      "description": "Recorded business expenditure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "paymentChannel": { "type": "string", "enum": ["Cash", "MoMo", "Personal"] },
        "payee": { "type": "string" },
        "memo": { "type": "string" },
        "receiptImageUrl": { "type": "string" },
        "date": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "amount", "category", "paymentChannel"]
    },
    "customers": {
      "title": "Customer",
      "description": "Customer directory and debtor balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "outstandingCredit": { "type": "number" },
        "creditLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "overdue", "blocked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name"]
    },
    "customer_credit": {
      "title": "CustomerCredit",
      "description": "Individual credit entry (owe ledger)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "customerId": { "type": "string" },
        "saleId": { "type": "string" },
        "amount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balance": { "type": "number" },
        "dueDate": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "partially_paid", "cleared", "overdue"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "customerId", "amount", "balance", "status"]
    },
    "credit_payments": {
      "title": "CreditPayment",
      "description": "Repayments against outstanding customer debt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "creditId": { "type": "string" },
        "customerId": { "type": "string" },
        "amountPaid": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "momo_mtn", "momo_telecel", "momo_at", "bank"] },
        "reference": { "type": "string" },
        "notes": { "type": "string" },
        "recordedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "creditId", "customerId", "amountPaid", "paymentMethod"]
    },
    "suppliers": {
      "title": "Supplier",
      "description": "Wholesale supplier or vendor in Ghana",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "marketLocation": { "type": "string" },
        "categoriesSupplied": { "type": "string" },
        "leadTimeDays": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "phone"]
    },
    "inventory_transactions": {
      "title": "InventoryTransaction",
      "description": "Stock audit trail for purchases, sales, adjustments, and spoils",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "productId": { "type": "string" },
        "type": { "type": "string", "enum": ["sale", "restock", "adjustment", "damaged", "return"] },
        "quantityChange": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "referenceId": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "businessId", "productId", "type", "quantityChange", "newStock"]
    },
    "notifications": {
      "title": "Notification",
      "description": "FCM cloud messaging and in-app system notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["low_stock", "debt_due", "daily_summary", "sale_target"] },
        "read": { "type": "boolean" },
        "dataPayload": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "title", "body", "type", "read"]
    },
    "subscriptions": {
      "title": "Subscription",
      "description": "MarketMate SME plan tier and mobile money billing status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "plan": { "type": "string", "enum": ["free_starter", "pro_trader", "enterprise_wholesale"] },
        "status": { "type": "string", "enum": ["active", "trialing", "past_due", "canceled"] },
        "priceGHS": { "type": "number" },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual"] },
        "currentPeriodEnd": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "plan", "status", "priceGHS"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "users", "description": "User profiles" },
    "/businesses/{businessId}": { "schema": "businesses", "description": "SME business data" },
    "/products/{productId}": { "schema": "products", "description": "Inventory products" },
    "/sales/{saleId}": { "schema": "sales", "description": "Sales records" },
    "/sale_items/{saleItemId}": { "schema": "sale_items", "description": "Line items for sales" },
    "/expenses/{expenseId}": { "schema": "expenses", "description": "Expenses and payouts" },
    "/customers/{customerId}": { "schema": "customers", "description": "Customer debtors and contacts" },
    "/customer_credit/{creditId}": { "schema": "customer_credit", "description": "Debt ledger records" },
    "/credit_payments/{paymentId}": { "schema": "credit_payments", "description": "Debt repayments" },
    "/suppliers/{supplierId}": { "schema": "suppliers", "description": "Suppliers and vendors" },
    "/inventory_transactions/{transactionId}": { "schema": "inventory_transactions", "description": "Stock movement audit log" },
    "/notifications/{notificationId}": { "schema": "notifications", "description": "In-app and FCM alerts" },
    "/subscriptions/{subscriptionId}": { "schema": "subscriptions", "description": "Subscription plans" }
  }
}
